{
  "name": "vue-qs",
  "version": "0.2.1",
  "description": "Type-safe search params state manager for Vue 3 - a port of nuqs",
  "license": "MIT",
  "author": {
    "name": "Somraj Mukherjee",
    "email": "iamsomraj@gmail.com",
    "url": "https://github.com/iamsomraj"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./server": {
      "import": {
        "types": "./dist/server.d.ts",
        "default": "./dist/server.js"
      },
      "require": {
        "types": "./dist/server.d.cts",
        "default": "./dist/server.cjs"
      }
    },
    "./adapters/history": {
      "import": {
        "types": "./dist/adapters/history.d.ts",
        "default": "./dist/adapters/history.js"
      },
      "require": {
        "types": "./dist/adapters/history.d.cts",
        "default": "./dist/adapters/history.cjs"
      }
    },
    "./adapters/vue-router": {
      "import": {
        "types": "./dist/adapters/vue-router.d.ts",
        "default": "./dist/adapters/vue-router.js"
      },
      "require": {
        "types": "./dist/adapters/vue-router.d.cts",
        "default": "./dist/adapters/vue-router.cjs"
      }
    },
    "./adapters/testing": {
      "import": {
        "types": "./dist/adapters/testing.d.ts",
        "default": "./dist/adapters/testing.js"
      },
      "require": {
        "types": "./dist/adapters/testing.d.cts",
        "default": "./dist/adapters/testing.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "server": [
        "./dist/server.d.ts"
      ],
      "adapters/history": [
        "./dist/adapters/history.d.ts"
      ],
      "adapters/vue-router": [
        "./dist/adapters/vue-router.d.ts"
      ],
      "adapters/testing": [
        "./dist/adapters/testing.d.ts"
      ]
    }
  },
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "keywords": [
    "vue",
    "vue3",
    "nuxt",
    "nuqs",
    "composition-api",
    "composables",
    "search-params",
    "query-string",
    "url-state",
    "url",
    "router",
    "vue-router",
    "state-management",
    "typescript",
    "ssr"
  ],
  "packageManager": "bun@1.4.3",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iamsomraj/vue-qs.git",
    "directory": "."
  },
  "bugs": {
    "url": "https://github.com/iamsomraj/vue-qs/issues"
  },
  "homepage": "https://iamsomraj.github.io/vue-qs/",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "tsup --watch",
    "build": "tsup",
    "test": "vitest run --typecheck",
    "test:watch": "vitest --typecheck",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --check \"**/*.{ts,tsx,js,json,md,yml,yaml}\"",
    "format:fix": "prettier --write \"**/*.{ts,tsx,js,json,md,yml,yaml}\"",
    "prepublishOnly": "bun run typecheck && bun run lint && bun run test && bun run build",
    "docs:dev": "bun run docs:api && vitepress dev docs",
    "docs:build": "bun run docs:api && vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "docs:api": "typedoc && cp docs/api/README.md docs/api/index.md",
    "docs:deploy": "gh workflow run docs.yml"
  },
  "peerDependencies": {
    "vue": "^3.3.0",
    "vue-router": "^4.2.0 || ^5.0.0"
  },
  "peerDependenciesMeta": {
    "vue-router": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "@typescript-eslint/eslint-plugin": "^8.71.1",
    "@typescript-eslint/parser": "^8.71.1",
    "eslint": "^10.12.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.17.1",
    "globals": "^17.13.0",
    "happy-dom": "^21.0.1",
    "prettier": "^3.9.10",
    "tsup": "^8.5.1",
    "typedoc": "^0.28.20",
    "typedoc-plugin-markdown": "^4.13.1",
    "typescript": "~6.0.3",
    "vite": "^8.3.4",
    "vitepress": "^1.6.4",
    "vitest": "^5.0.4",
    "vue": "^3.5.43",
    "vue-router": "^5.4.0"
  },
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/iamsomraj"
  },
  "overrides": {
    "vite": "^8.3.4",
    "esbuild": "^0.28.2"
  }
}
