{
  "name": "vue-qs",
  "version": "0.2.0",
  "description": "Type-safe search params state manager for Vue 3 - a port of nuqs",
  "license": "MIT",
  "author": {
    "name": "Somraj Mukherjee",
    "email": "iamsomraj@gmail.com",
    "url": "https://github.com/iamsomraj"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./server": {
      "import": {
        "types": "./dist/server.d.ts",
        "default": "./dist/server.js"
      },
      "require": {
        "types": "./dist/server.d.cts",
        "default": "./dist/server.cjs"
      }
    },
    "./adapters/history": {
      "import": {
        "types": "./dist/adapters/history.d.ts",
        "default": "./dist/adapters/history.js"
      },
      "require": {
        "types": "./dist/adapters/history.d.cts",
        "default": "./dist/adapters/history.cjs"
      }
    },
    "./adapters/vue-router": {
      "import": {
        "types": "./dist/adapters/vue-router.d.ts",
        "default": "./dist/adapters/vue-router.js"
      },
      "require": {
        "types": "./dist/adapters/vue-router.d.cts",
        "default": "./dist/adapters/vue-router.cjs"
      }
    },
    "./adapters/testing": {
      "import": {
        "types": "./dist/adapters/testing.d.ts",
        "default": "./dist/adapters/testing.js"
      },
      "require": {
        "types": "./dist/adapters/testing.d.cts",
        "default": "./dist/adapters/testing.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "server": [
        "./dist/server.d.ts"
      ],
      "adapters/history": [
        "./dist/adapters/history.d.ts"
      ],
      "adapters/vue-router": [
        "./dist/adapters/vue-router.d.ts"
      ],
      "adapters/testing": [
        "./dist/adapters/testing.d.ts"
      ]
    }
  },
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "keywords": [
    "vue",
    "vue3",
    "nuxt",
    "nuqs",
    "composition-api",
    "composables",
    "search-params",
    "query-string",
    "url-state",
    "url",
    "router",
    "vue-router",
    "state-management",
    "typescript",
    "ssr"
  ],
  "packageManager": "bun@1.2.19",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iamsomraj/vue-qs.git",
    "directory": "."
  },
  "bugs": {
    "url": "https://github.com/iamsomraj/vue-qs/issues"
  },
  "homepage": "https://iamsomraj.github.io/vue-qs/",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "tsup --watch",
    "build": "tsup",
    "test": "vitest run --typecheck",
    "test:watch": "vitest --typecheck",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ext .ts,.tsx,.cts,.mts",
    "lint:fix": "eslint . --ext .ts,.tsx,.cts,.mts --fix",
    "format": "prettier --check \"**/*.{ts,tsx,js,json,md,yml,yaml}\"",
    "format:fix": "prettier --write \"**/*.{ts,tsx,js,json,md,yml,yaml}\"",
    "prepare": "echo 'no git hooks'",
    "prepublishOnly": "bun run typecheck && bun run lint && bun run test && bun run build",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "docs:api": "typedoc && cp docs/api/README.md docs/api/index.md",
    "docs:all": "bun run docs:api && bun run docs:build",
    "docs:deploy": "DOCS_BASE=/vue-qs/ bun run docs:all && DOCS_BASE=/vue-qs/ vitepress build docs && gh-pages -d docs/.vitepress/dist -b gh-pages --dotfiles"
  },
  "peerDependencies": {
    "vue": "^3.3.0",
    "vue-router": "^4.2.0"
  },
  "peerDependenciesMeta": {
    "vue-router": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@eslint/js": "^9.33.0",
    "@types/node": "^22.7.4",
    "@typescript-eslint/eslint-plugin": "^8.5.0",
    "@typescript-eslint/parser": "^8.5.0",
    "eslint": "^9.12.0",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.32.0",
    "gh-pages": "^6.1.1",
    "globals": "^16.3.0",
    "happy-dom": "^18.0.1",
    "prettier": "^3.3.3",
    "tsup": "^8.2.4",
    "typedoc": "^0.28.10",
    "typedoc-plugin-markdown": "^4.8.0",
    "typescript": "^5.9.2",
    "vitepress": "^1.5.0",
    "vitest": "^2.1.2",
    "vue": "^3.5.10",
    "vue-router": "^4.4.5"
  },
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/iamsomraj"
  }
}
